# Grounded boot splash.
# The alien mark sits at the center of the screen. Its three ground bars light up
# one after another, top to bottom, and repeat. Below it, a borderless panel shows
# the last journal lines, which splash-journal.service sends with
# `plymouth display-message`. Colors are the Grounded dark theme tokens.

# --- Screen ---------------------------------------------------------------------
# ground #13181a
Window.SetBackgroundTopColor(0.075, 0.094, 0.102);
Window.SetBackgroundBottomColor(0.075, 0.094, 0.102);

screen.x = Window.GetX();
screen.y = Window.GetY();
screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

# --- Mark -----------------------------------------------------------------------
# Use the largest pre-rendered size (see build.sh) that is at most ~21% of the
# screen height, so the mark stays sharp without scaling.
sizes[0] = 160; sizes[1] = 224; sizes[2] = 288; sizes[3] = 448;
mark.size = sizes[0];
for (i = 1; i < 4; i++)
  if (sizes[i] <= screen.h * 0.21)
    mark.size = sizes[i];

mark.x = screen.x + Math.Int((screen.w - mark.size) / 2);
mark.y = screen.y + Math.Int((screen.h - mark.size) / 2);

head = Sprite(Image("head-" + mark.size + ".png"));
head.SetPosition(mark.x, mark.y, 10);
head.SetOpacity(0);
for (i = 0; i < 3; i++)
  {
    bar[i] = Sprite(Image("bar" + (i + 1) + "-" + mark.size + ".png"));
    bar[i].SetPosition(mark.x, mark.y, 10);
    bar[i].SetOpacity(0);
  }

# --- Journal panel --------------------------------------------------------------
LINES = 6;
font_pt = Math.Clamp(Math.Int(screen.h / 108), 9, 18);   # 10pt (13px) at 1080p
FONT = "IBM Plex Mono " + font_pt;
font_px = font_pt * 96 / 72;

panel.pad = Math.Int(font_px * 1.2);
panel.line_h = Math.Int(font_px * 1.5);
panel.w = Math.Min(screen.w - 2 * panel.pad, Math.Max(Math.Int(screen.w * 0.5), 640));
panel.h = 2 * panel.pad + LINES * panel.line_h;
panel.x = screen.x + Math.Int((screen.w - panel.w) / 2);
panel.gap = Math.Int(mark.size * 0.29);                  # ~64px (space-6) at 1080p
panel.y = mark.y + mark.size + panel.gap;
panel.text_w = panel.w - 2 * panel.pad;

# The panel stays hidden until the first line arrives (e.g. at shutdown, where
# nothing feeds it).
panel.sprite = Sprite(Image("panel.png").Tile(panel.w, panel.h));
panel.sprite.SetPosition(panel.x, panel.y, 20);
panel.sprite.SetOpacity(0);

# --- Journal rows ---------------------------------------------------------------
# splash-journal sends "<kind>|<seconds since boot>|<text>" for each journal entry,
# and each row reads like systemd's console:
#      3.364  [  OK  ]  Started User Login Management.
# The time and brackets are faint, the status word has its own color, and the text
# is ink (newest line) or ink-muted (older lines). Any other message (one not sent
# by splash-journal) is shown as plain text across the whole row.

# Grounded dark theme colors.
fun text_image(text, color)
  {
    if (color == "ink")
      return Image.Text(text, 0.914, 0.929, 0.922, 1, FONT);   # ink #e9edeb
    if (color == "muted")
      return Image.Text(text, 0.588, 0.631, 0.620, 1, FONT);   # ink-muted #96a19e
    if (color == "signal")
      return Image.Text(text, 0.718, 0.953, 0.302, 1, FONT);   # signal #b7f34d
    if (color == "copper")
      return Image.Text(text, 0.878, 0.541, 0.298, 1, FONT);   # copper #e08a4c
    if (color == "error")
      return Image.Text(text, 1.000, 0.608, 0.478, 1, FONT);   # error #ff9b7a
    return Image.Text(text, 0.427, 0.486, 0.439, 1, FONT);     # faint: hairline-strong #6d7c70
  }

# Status words, six characters wide like systemd's, drawn inside "[      ]".
tag["ok"]   = text_image("  OK  ", "signal");
tag["fail"] = text_image("FAILED", "error");
tag["time"] = text_image(" TIME ", "error");
tag["err"]  = text_image("ERROR ", "error");
tag["dep"]  = text_image("DEPEND", "copper");
tag["warn"] = text_image(" WARN ", "copper");
tag["info"] = text_image(" INFO ", "muted");

fun is_kind(kind)
  {
    return kind == "ok" || kind == "fail" || kind == "time" || kind == "err"
        || kind == "dep" || kind == "warn" || kind == "info";
  }

# Columns, in monospace cells: time (8), gap (2), tag (8), gap (2), text.
brackets = text_image("[      ]", "faint");
cell_w = brackets.GetWidth() / 8;
col.tag = Math.Int(10 * cell_w);
col.word = Math.Int(11 * cell_w);
col.text = Math.Int(20 * cell_w);

for (i = 0; i < LINES; i++)
  {
    row_time[i] = Sprite();
    row_tag[i] = Sprite(brackets);
    row_word[i] = Sprite();
    row_text[i] = Sprite();
    row_time[i].SetOpacity(0);
    row_tag[i].SetOpacity(0);
    row_word[i].SetOpacity(0);
    row_text[i].SetOpacity(0);
  }
line_count = 0;

fun render_text(text, newest, tagged)
  {
    if (text == "")
      text = " ";
    if (newest)
      image = text_image(text, "ink");
    else
      image = text_image(text, "muted");
    # Clip at the panel padding instead of wrapping, like a terminal.
    width = panel.text_w;
    if (tagged)
      width = panel.text_w - col.text;
    if (image.GetWidth() > width)
      image = image.Crop(0, 0, width, image.GetHeight());
    return image;
  }

fun place(sprite, image, x, y, opacity)
  {
    sprite.SetImage(image);
    sprite.SetPosition(x, y + Math.Int((panel.line_h - image.GetHeight()) / 2), 21);
    sprite.SetOpacity(opacity);
  }

fun layout_rows()
  {
    x = panel.x + panel.pad;
    for (i = 0; i < LINES; i++)
      {
        if (i < line_count)
          {
            y = panel.y + panel.pad + i * panel.line_h;
            # Newest line fully opaque, older ones fade out toward the top.
            opacity = 1 - (line_count - 1 - i) * 0.14;
            if (line_kind[i] == "")
              {
                place(row_text[i], line_image[i], x, y, opacity);
                row_time[i].SetOpacity(0);
                row_tag[i].SetOpacity(0);
                row_word[i].SetOpacity(0);
              }
            else
              {
                place(row_time[i], line_time[i], x, y, opacity);
                place(row_tag[i], brackets, x + col.tag, y, opacity);
                place(row_word[i], tag[line_kind[i]], x + col.word, y, opacity);
                place(row_text[i], line_image[i], x + col.text, y, opacity);
              }
          }
        else
          {
            row_time[i].SetOpacity(0);
            row_tag[i].SetOpacity(0);
            row_word[i].SetOpacity(0);
            row_text[i].SetOpacity(0);
          }
      }
    panel.sprite.SetOpacity(1);
  }

fun display_message_callback(message)
  {
    # Split "<kind>|<time>|<text>" at its first two bars.
    kind = "";
    time = "";
    text = message;
    len = message.Length();
    first = -1;
    second = -1;
    for (i = 0; i < len && i < 24 && second < 0; i++)
      if (message.CharAt(i) == "|")
        {
          if (first < 0)
            first = i;
          else
            second = i;
        }
    if (second > 0 && is_kind(message.SubString(0, first)))
      {
        kind = message.SubString(0, first);
        time = message.SubString(first + 1, second);
        text = message.SubString(second + 1, len);
      }

    if (line_count == LINES)
      {
        for (i = 1; i < LINES; i++)
          {
            global.line_kind[i - 1] = line_kind[i];
            global.line_time[i - 1] = line_time[i];
            global.line_text[i - 1] = line_text[i];
            global.line_image[i - 1] = line_image[i];
          }
        global.line_count = LINES - 1;
      }
    # The line that was newest turns muted.
    if (line_count > 0)
      global.line_image[line_count - 1] =
        render_text(line_text[line_count - 1], 0, line_kind[line_count - 1] != "");
    global.line_kind[line_count] = kind;
    global.line_time[line_count] = text_image(time, "faint");
    global.line_text[line_count] = text;
    global.line_image[line_count] = render_text(text, 1, kind != "");
    global.line_count++;
    layout_rows();
  }

Plymouth.SetDisplayMessageFunction(display_message_callback);

# --- Prompts (disk passwords, questions) ----------------------------------------
# Shown centered between the mark and the panel, in signal green.
prompt = Sprite();
prompt.SetOpacity(0);

fun show_prompt(text)
  {
    image = Image.Text(text, 0.718, 0.953, 0.302, 1, FONT);   # signal #b7f34d
    prompt.SetImage(image);
    prompt.SetPosition(screen.x + Math.Int((screen.w - image.GetWidth()) / 2),
                       mark.y + mark.size + Math.Int((panel.gap - image.GetHeight()) / 2),
                       30);
    prompt.SetOpacity(1);
  }

fun display_password_callback(text, bullets)
  {
    if (text == "")
      text = "Password";
    dots = "";
    for (i = 0; i < bullets; i++)
      dots += "•";
    show_prompt(text + "  " + dots);
  }

fun display_question_callback(text, entry)
  {
    show_prompt(text + "  " + entry);
  }

fun display_normal_callback()
  {
    prompt.SetOpacity(0);
  }

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- Animation ------------------------------------------------------------------
# Times in seconds; the refresh callback runs 50 times a second.
FPS = 50;
HEAD_FADE = 0.5;   # head fades in once at start
STEP = 0.35;       # bar n lights at n * STEP
RAMP = 0.12;       # each bar's quick ramp from dim to lit
HOLD_END = 1.4;    # all three lit until here,
FADE = 0.2;        # then they dim together,
CYCLE = 1.75;      # and the cycle restarts.
DIM = 0.2;         # opacity of an unlit bar
frame = 0;

fun refresh_callback()
  {
    t = frame / FPS;
    global.frame++;
    shown = Math.Min(t / HEAD_FADE, 1);
    head.SetOpacity(shown);

    tc = t - Math.Int(t / CYCLE) * CYCLE;
    release = Math.Clamp((HOLD_END + FADE - tc) / FADE, 0, 1);
    for (i = 0; i < 3; i++)
      {
        lit = Math.Clamp((tc - (i + 1) * STEP) / RAMP, 0, 1) * release;
        bar[i].SetOpacity((DIM + (1 - DIM) * lit) * shown);
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);

# Leave the mark whole (all bars lit) as the splash hands over to the login.
fun quit_callback()
  {
    head.SetOpacity(1);
    for (i = 0; i < 3; i++)
      bar[i].SetOpacity(1);
  }

Plymouth.SetQuitFunction(quit_callback);

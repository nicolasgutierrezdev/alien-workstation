# Notifications, Grounded theme. $mod+n dismisses all, $mod+Shift+n restores.
font=IBM Plex Sans 10
background-color=#1b2124
text-color=#e9edeb
border-color=#2b3335
border-size=1
border-radius=0
progress-color=over #20362a
padding=12,16
margin=8
width=360
max-visible=4
default-timeout=6000
anchor=top-right
markup=1
format=<b>%s</b>\n%b

[urgency=high]
border-color=#e08a4c
default-timeout=0

[mode=do-not-disturb]
invisible=1
